# Public entry port (Nginx)
APP_PORT=8810

# Browser origin for CORS (keep in sync with APP_PORT / host)
CORS_ORIGINS=http://localhost:8810

# Postgres (used by db service and backend DATABASE_URL)
POSTGRES_USER=hours
POSTGRES_PASSWORD=hours
POSTGRES_DB=hours_station

# 镜像源（构建 backend 镜像时使用；默认腾讯云公共源，迁云/换源可取消注释覆盖）
# APT_MIRROR=mirrors.cloud.tencent.com
# PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple/
